# -------------------------------------------------------------------
# Current runtime configuration
# These variables are already read by the current codebase.
# -------------------------------------------------------------------

AGENT_EDU_APP_ENV=development
AGENT_EDU_API_PORT=8000

# Container/network example:
AGENT_EDU_DATABASE_URL=postgresql+asyncpg://agent_edu:agent_edu@postgres:5432/agent_edu
AGENT_EDU_REDIS_URL=redis://redis:6379/0

# Local machine examples:
# AGENT_EDU_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_edu
# AGENT_EDU_REDIS_URL=redis://localhost:6379/0

AGENT_EDU_ALLOWED_SKILLS=explain_concept,create_quiz,adaptive_hint
AGENT_EDU_REFLECTION_MAX_DEPTH=2
AGENT_EDU_METRICS_ENABLED=0

# Bounded long-term memory maintenance worker settings.
AGENT_EDU_MEMORY_MAINTENANCE_JOBS_PER_TICK=5
AGENT_EDU_MEMORY_MAINTENANCE_BATCH_SIZE=20
AGENT_EDU_MEMORY_MAINTENANCE_LEASE_SECONDS=300
AGENT_EDU_MEMORY_MAINTENANCE_RETRY_MAX_ATTEMPTS=3

# Optional API credentials.
# AGENT_EDU_OPERATOR_API_KEY=<operator-secret>
# AGENT_EDU_LEARNER_ACCESS_KEY=<profile-access-key>

# Skill rollout auto-governance.
# V1 only auto-governs rollout promote / rollback for allowlisted workflow surfaces.
AGENT_EDU_SKILL_ROLLOUT_AUTO_GOVERNANCE_ENABLED=1
AGENT_EDU_SKILL_ROLLOUT_AUTO_PROMOTE_ENABLED=1
AGENT_EDU_SKILL_ROLLOUT_AUTO_ROLLBACK_ENABLED=1
AGENT_EDU_SKILL_ROLLOUT_AUTO_PROMOTE_SURFACES=chat,hint,quiz,plan_generation,review_scheduling,assessment_generation,replan
AGENT_EDU_SKILL_ROLLOUT_AUTO_ROLLBACK_SURFACES=chat,hint,quiz,plan_generation,review_scheduling,assessment_generation,replan

# Optional proxy settings for container build/runtime network access.
# Recommended default for VMware NAT on a local Linux VM:
# use the host VMnet8 address instead of a changing WLAN address.
# HTTP_PROXY=http://192.168.127.1:10808
# HTTPS_PROXY=http://192.168.127.1:10808
# If your proxy is SOCKS-based instead of HTTP, use ALL_PROXY instead:
# ALL_PROXY=socks5://192.168.127.1:10808
# NO_PROXY=localhost,127.0.0.1,postgres,redis,api,prometheus,grafana

# The current implementation only supports the mock provider.
AGENT_EDU_LLM_PROVIDER=mock
AGENT_EDU_LLM_MODEL=mock-tutor-v1

# -------------------------------------------------------------------
# Real model API integration
# These variables are now supported by the current codebase.
# -------------------------------------------------------------------

# Example future values:
# AGENT_EDU_LLM_PROVIDER=openai
# AGENT_EDU_LLM_MODEL=gpt-4.1-mini

# Aliyun DashScope OpenAI-compatible chat example:
# AGENT_EDU_LLM_PROVIDER=dashscope_compatible
# AGENT_EDU_LLM_MODEL=qwen3.5-flash
# AGENT_EDU_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_EDU_LLM_API_KEY=<secret>

# Shared provider access
# AGENT_EDU_LLM_API_KEY=<secret>
# AGENT_EDU_LLM_BASE_URL=https://api.openai.com/v1
# AGENT_EDU_LLM_TIMEOUT_SECONDS=30
# AGENT_EDU_LLM_MAX_RETRIES=2

# Default generation controls
# AGENT_EDU_LLM_TEMPERATURE=0.2
# AGENT_EDU_LLM_MAX_OUTPUT_TOKENS=1200

# Optional per-capability model overrides
# AGENT_EDU_TUTOR_MODEL=gpt-4.1-mini
# AGENT_EDU_QUIZ_MODEL=gpt-4.1-mini
# AGENT_EDU_HINT_MODEL=gpt-4.1-mini

# Optional embedding configuration for later memory retrieval work
# AGENT_EDU_EMBEDDING_PROVIDER=openai
# AGENT_EDU_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_EDU_EMBEDDING_API_KEY=<secret>
# AGENT_EDU_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AGENT_EDU_EMBEDDING_DIMENSIONS=1536
# AGENT_EDU_EMBEDDING_TIMEOUT_SECONDS=30

# Aliyun DashScope embedding example:
# AGENT_EDU_EMBEDDING_PROVIDER=dashscope
# AGENT_EDU_EMBEDDING_MODEL=text-embedding-v4
# AGENT_EDU_EMBEDDING_API_KEY=<secret>
# AGENT_EDU_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_EDU_EMBEDDING_DIMENSIONS=1024
# AGENT_EDU_EMBEDDING_TIMEOUT_SECONDS=30
#
# If the embedding implementation uses the official DashScope SDK,
# you may also want this provider-native variable:
# DASHSCOPE_API_KEY=<secret>
#
# If embedding API key or base URL is omitted, the app falls back to the
# corresponding AGENT_EDU_LLM_* values.

# -------------------------------------------------------------------
# Test and observability helpers
# These are used by external blackbox tests and Docker validation.
# -------------------------------------------------------------------

# AGENT_EDU_API_BASE_URL=http://api:8000
# AGENT_EDU_RUN_REAL_PROVIDER_REGRESSION=0
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
