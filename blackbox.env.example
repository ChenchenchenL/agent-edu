# Blackbox env: override .env for Docker MVP smoke.
# Usage:
#   docker compose --env-file blackbox.env up -d postgres redis api
#   docker compose --env-file blackbox.env --profile test run --rm \
#       -e AGENT_EDU_API_BASE_URL=http://api:8000 \
#       tester pytest tests/test_mvp_blackbox.py -q
AGENT_EDU_LLM_PROVIDER=mock
AGENT_EDU_LLM_MODEL=mock-tutor-v1
AGENT_EDU_TUTOR_MODEL=mock-tutor-v1
AGENT_EDU_QUIZ_MODEL=mock-quiz-v1
AGENT_EDU_HINT_MODEL=mock-hint-v1
AGENT_EDU_EMBEDDING_PROVIDER=mock
AGENT_EDU_EMBEDDING_MODEL=mock-embedding-v1
AGENT_EDU_LLM_API_KEY=
AGENT_EDU_LLM_BASE_URL=
AGENT_EDU_EMBEDDING_API_KEY=
AGENT_EDU_EMBEDDING_BASE_URL=
AGENT_EDU_OPERATOR_API_KEY=secret-operator
